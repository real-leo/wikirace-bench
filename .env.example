# Optional LLM / Typesafe keys (overlap brain needs none)
TYPESAFE_API_KEY=
# Optional local Chromium configuration (leave empty for automatic detection).
WIKIRACE_BROWSER_PATH=
WIKIRACE_BROWSER_PROXY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# Optional MLX checkpoint path (defaults to repository models/laya-mlx).
# LAYA_MLX_MODEL=/absolute/path/to/laya-mlx

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GPT_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Unified 255-candidate chat baseline (dedicated runner; key stays in .env).
HOTDAY_API_KEY=
HOTDAY_BASE_URL=https://api.hotday.uk/v1
HOTDAY_MODEL=models/gemini-3.8-flash

# Browser (DrissionPage / Chromium). Headless default is CLI --headless.
# WIKIRACE_LANG=en
